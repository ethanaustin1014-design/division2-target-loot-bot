# Create a Discord application at https://discord.com/developers/applications
DISCORD_TOKEN=put_your_bot_token_here

# Discord channel ID for the dedicated target-loot channel
DISCORD_CHANNEL_ID=put_channel_id_here

# Must be Europe/London so the schedule follows GMT/BST automatically
TIME_ZONE=Europe/London
POST_CRON=2 8 * * *

# Approved ProtoTrack JSON/API endpoint goes here.
# Do not point this at an undocumented/private endpoint without ProtoTrack's permission.
PROTOTRACK_API_URL=

# Optional public image URL supplied by the approved feed. If absent, the bot generates a card.
PROTOTRACK_IMAGE_URL=

# Optional attribution URL; defaults to ProtoTrack's homepage.
PROTOTRACK_SOURCE_URL=https://prototrack.gg/
